# Frontend build-time config (Vite). Copy to .env.local for local overrides,
# or set these in the Vercel project's Environment Variables.

# Backend base URL. Leave EMPTY for single-origin deploys (FastAPI serves this
# bundle). Set to your backend's origin for a split deploy, e.g.:
#   VITE_API_BASE=https://bookrec-api.fly.dev
VITE_API_BASE=
